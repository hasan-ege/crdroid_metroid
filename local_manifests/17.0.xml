<?xml version="1.0" encoding="UTF-8"?>
<!-- crDroid 17.0 (Android 17) for the Nothing Phone (3) "metroid".
     Put this file in .repo/local_manifests/ of a crDroid 17.0 checkout, then repo sync.
     vendor/nothing/metroid (Nothing's proprietary blobs) is not published: extract it from a
     stock Nothing OS image with device/nothing/metroid/extract-files.py. -->
<manifest>
  <remote name="hasan-ege" fetch="https://github.com/hasan-ege" />

  <project path="device/nothing/metroid" name="android_device_nothing_metroid" remote="hasan-ege" revision="17.0" />
  <project path="packages/apps/OpenGlyph" name="OpenGlyph" remote="hasan-ege" revision="main" />

  <remove-project name="crdroidandroid/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="hasan-ege" revision="metroid-17.0" groups="pdk-cw-fs,pdk-fs" />
  <remove-project name="crdroidandroid/android_packages_apps_Settings" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="hasan-ege" revision="metroid-17.0" />
  <remove-project name="crdroidandroid/android_packages_apps_SetupWizard" />
  <project path="packages/apps/SetupWizard" name="android_packages_apps_SetupWizard" remote="hasan-ege" revision="metroid-17.0" />
  <remove-project name="crdroidandroid/android_packages_services_Telecomm" />
  <project path="packages/services/Telecomm" name="android_packages_services_Telecomm" remote="hasan-ege" revision="metroid-17.0" />
  <remove-project name="crdroidandroid/android_vendor_crdroid" />
  <project path="vendor/lineage" name="android_vendor_crdroid" remote="hasan-ege" revision="metroid-17.0" />
  <remove-project name="LineageOS/android_packages_apps_Aperture" />
  <project path="packages/apps/Aperture" name="android_packages_apps_Aperture" remote="hasan-ege" revision="metroid-17.0" />

  <!-- metroid ships Nothing's stock RichTap vibrator; the QTI source HAL would generate the
       same output paths, which siso rejects. -->
  <remove-project name="LineageOS/android_vendor_qcom_opensource_vibrator" />
</manifest>
