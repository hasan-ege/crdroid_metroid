From 50913d72d8e15b87e19e337dd0574a0b29abed3c Mon Sep 17 00:00:00 2001
From: hasan <hasan@localhost>
Date: Sun, 18 Oct 2026 06:11:25 +0300
Subject: [PATCH 2/5] metroid: turn off the recording LED and drop the crashing
 eSIM LPA

- lineage-sdk overlay: config_buttonBrightnessSettingDefaultFloat 0.0. There are
  no backlit keys; the stock lights HAL maps the BUTTONS light to the red camera
  recording LED, which lit up whenever the screen was on.
- Leave out uimlpaservice (com.qualcomm.qti.lpa): with the eSIM slot reported
  empty it crashes in uimLpaGetEid (index -1) and shows an ANR dialog.
---
 lineage_metroid.mk                                    | 5 +++++
 overlay/lineage-sdk/lineage/res/res/values/config.xml | 4 ++++
 2 files changed, 9 insertions(+)

diff --git a/lineage_metroid.mk b/lineage_metroid.mk
index ee354fa..9c7e31e 100644
--- a/lineage_metroid.mk
+++ b/lineage_metroid.mk
@@ -12,6 +12,11 @@ $(call inherit-product, device/nothing/metroid/device.mk)
 # Keep only Nothing's stock AW86938/RichTap implementation.
 PRODUCT_PACKAGES := $(filter-out vendor.qti.hardware.vibrator.service,$(PRODUCT_PACKAGES))
 
+# The modem reports the embedded eSIM slot as empty, so Qualcomm's LPA service
+# (com.qualcomm.qti.lpa) crashes with index -1 in uimLpaGetEid and shows
+# "isn't responding". eSIM does not work on this build anyway; leave it out.
+PRODUCT_PACKAGES := $(filter-out uimlpaservice,$(PRODUCT_PACKAGES))
+
 # Sign with our own release keys, not AOSP's public testkey (anyone can forge updates for that).
 $(call inherit-product-if-exists, vendor/lineage-priv/keys/keys.mk)
 
diff --git a/overlay/lineage-sdk/lineage/res/res/values/config.xml b/overlay/lineage-sdk/lineage/res/res/values/config.xml
index 9cc40a6..7d9ebd7 100644
--- a/overlay/lineage-sdk/lineage/res/res/values/config.xml
+++ b/overlay/lineage-sdk/lineage/res/res/values/config.xml
@@ -11,4 +11,8 @@
     <string-array name="config_deviceKeyHandlerClasses" translatable="false">
         <item>org.lineageos.settings.device.KeyHandler</item>
     </string-array>
+
+    <!-- No backlit hardware keys. The stock lights HAL exposes a BUTTONS light that drives the
+         red camera recording LED, so a non-zero default lit it whenever the screen was on. -->
+    <dimen name="config_buttonBrightnessSettingDefaultFloat">0.0</dimen>
 </resources>
