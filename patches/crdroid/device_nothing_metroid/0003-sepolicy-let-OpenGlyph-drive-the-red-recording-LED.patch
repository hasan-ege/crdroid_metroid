From b010096a565a66f109bd252bb5a6ac7ebab9045b Mon Sep 17 00:00:00 2001
From: hasan <hasan@localhost>
Date: Sun, 18 Oct 2026 06:29:50 +0300
Subject: [PATCH 3/5] sepolicy: let OpenGlyph drive the red recording LED

Label the pmxr2230 PWM LED controller (red = /sys/class/leds/red) sysfs_leds and
allow system_app to use its trigger/delay_on/delay_off. ueventd already gives
those three attributes to the system user.
---
 sepolicy/private/genfs_contexts | 5 +++++
 sepolicy/private/glyph.te       | 6 ++++++
 2 files changed, 11 insertions(+)

diff --git a/sepolicy/private/genfs_contexts b/sepolicy/private/genfs_contexts
index 7d52cee..9e9af91 100644
--- a/sepolicy/private/genfs_contexts
+++ b/sepolicy/private/genfs_contexts
@@ -1,3 +1,8 @@
 # Label the Glyph Matrix LED sysfs so the platform GlyphService can drive it.
 # SPI path from stock: soc/8c0000.qcom,qupv3_2_geni_se/888000.spi/spi_master/spi10/spi10.0/leds/matrix-leds
 genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/888000.spi/spi_master/spi10/spi10.0/leds/matrix-leds u:object_r:sysfs_led_driver_info:s0
+
+# Red camera recording LED (pmxr2230 PWM LED controller, DT label "red" = /sys/class/leds/red).
+# Path follows the sm8750 SPMI pattern (…/spmi-0/0-0N/c42d000.qcom,spmi:qcom,<pmic>@N:<node>);
+# OpenGlyph logs the canonical path at start so a wrong guess shows up in logcat.
+genfscon sysfs /devices/platform/soc/c42d000.qcom,spmi/spmi-0/0-01/c42d000.qcom,spmi:qcom,pmxr2230@1:led-controller u:object_r:sysfs_leds:s0
diff --git a/sepolicy/private/glyph.te b/sepolicy/private/glyph.te
index a395019..897f15c 100644
--- a/sepolicy/private/glyph.te
+++ b/sepolicy/private/glyph.te
@@ -6,3 +6,9 @@ allow system_app sysfs_led_driver_info:file rw_file_perms;
 # GlyphNotification also toggles the LED nodes.
 allow priv_app sysfs_led_driver_info:dir search;
 allow priv_app sysfs_led_driver_info:file rw_file_perms;
+
+# OpenGlyph (org.openglyph, uid system) blinks the red recording LED with the kernel timer
+# trigger: /sys/class/leds is a sysfs_leds symlink farm, the LED attributes are sysfs_leds too.
+allow system_app sysfs_leds:dir r_dir_perms;
+allow system_app sysfs_leds:lnk_file read;
+allow system_app sysfs_leds:file rw_file_perms;
