From 96aa6d4a03d10ede6bdc1b5b32f47bb19eefe078 Mon Sep 17 00:00:00 2001
From: hasan <hasan@localhost>
Date: Sun, 18 Oct 2026 06:30:31 +0300
Subject: [PATCH 4/5] metroid: ship OpenGlyph

---
 device.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/device.mk b/device.mk
index 6e00fa3..4030223 100644
--- a/device.mk
+++ b/device.mk
@@ -385,6 +385,11 @@ PRODUCT_PRECOMPILED_SEPOLICY := false
 # The Glyph apps are not installed yet (see above), so their sysconfig XML, which lived in
 # logix727's private vendor tree (vendor/nothing/metroid/glyph), is not copied either.
 
+# OpenGlyph: open-source Glyph Matrix service (packages/apps/OpenGlyph) in place of the closed
+# stock stack above: notification/charging/call effects, app API, red recording LED.
+PRODUCT_PACKAGES += \
+    OpenGlyph
+
 # OPUS bring-up: EARLY (system build.prop, before zygote) props — /vendor/build.prop loads too late here.
 # ro.hw_timeout_multiplier=4 -> framework Watchdog 60s*4=240s to survive the slow imageless first boot
 # (odsign fails -> no boot.art -> imageless -> system_server main thread >60s -> Watchdog kill loop).
-- 
