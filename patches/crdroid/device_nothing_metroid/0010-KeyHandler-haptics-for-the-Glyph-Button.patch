From 50d868034ed03af706daa21a6ce80110e19c6f05 Mon Sep 17 00:00:00 2001
From: hasan <hasan@localhost>
Date: Sun, 18 Oct 2026 08:03:34 +0300
Subject: [PATCH] KeyHandler: haptics for the Glyph Button

Click on press, heavy click once a held press reaches the long-press threshold
(600 ms). USAGE_TOUCH, so it follows the touch feedback setting.
---
 .../lineageos/settings/device/KeyHandler.java | 27 ++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/keyhandler/src/org/lineageos/settings/device/KeyHandler.java b/keyhandler/src/org/lineageos/settings/device/KeyHandler.java
index 5d105ac..c61822b 100644
--- a/keyhandler/src/org/lineageos/settings/device/KeyHandler.java
+++ b/keyhandler/src/org/lineageos/settings/device/KeyHandler.java
@@ -19,6 +19,9 @@ import android.hardware.camera2.CameraManager;
 import android.os.Handler;
 import android.os.HandlerThread;
 import android.os.UserHandle;
+import android.os.VibrationAttributes;
+import android.os.VibrationEffect;
+import android.os.Vibrator;
 import android.util.Log;
 import android.view.KeyEvent;
 
@@ -35,9 +38,16 @@ public class KeyHandler implements DeviceKeyHandler {
     private static final String EXTRA_EVENT = "event";
     private static final long LONG_PRESS_MS = 600;
 
+    // Touch usage: follows Settings > Sound & vibration > Touch feedback.
+    private static final VibrationAttributes HAPTIC_ATTRS =
+            VibrationAttributes.createForUsage(VibrationAttributes.USAGE_TOUCH);
+
     private final Context mContext;
     private final CameraManager mCameraManager;
     private final Handler mHandler;
+    private final Vibrator mVibrator;
+    // Heavy click when a held Glyph Button crosses LONG_PRESS_MS; cancelled on release.
+    private final Runnable mLongPressHaptic = () -> haptic(VibrationEffect.EFFECT_HEAVY_CLICK);
 
     private String mTorchCameraId = null;
     private boolean mTorchEnabled = false;
@@ -47,6 +57,7 @@ public class KeyHandler implements DeviceKeyHandler {
         HandlerThread thread = new HandlerThread(TAG);
         thread.start();
         mHandler = new Handler(thread.getLooper());
+        mVibrator = context.getSystemService(Vibrator.class);
         mCameraManager = context.getSystemService(CameraManager.class);
         if (mCameraManager != null) {
             // Track real torch state (covers QS-tile / other-client changes too).
@@ -98,8 +109,13 @@ public class KeyHandler implements DeviceKeyHandler {
     private void handleGlyphButton(KeyEvent event) {
         if (event.getRepeatCount() > 0) return;
         if (event.getAction() == KeyEvent.ACTION_DOWN) {
-            mHandler.post(() -> sendGlyphButton("down"));
+            mHandler.post(() -> {
+                haptic(VibrationEffect.EFFECT_CLICK);
+                sendGlyphButton("down");
+            });
+            mHandler.postDelayed(mLongPressHaptic, LONG_PRESS_MS);
         } else if (event.getAction() == KeyEvent.ACTION_UP) {
+            mHandler.removeCallbacks(mLongPressHaptic);
             boolean longPress = event.getEventTime() - event.getDownTime() >= LONG_PRESS_MS;
             mHandler.post(() -> {
                 sendGlyphButton("up");
@@ -108,6 +124,15 @@ public class KeyHandler implements DeviceKeyHandler {
         }
     }
 
+    private void haptic(int effect) {
+        if (mVibrator == null || !mVibrator.hasVibrator()) return;
+        try {
+            mVibrator.vibrate(VibrationEffect.createPredefined(effect), HAPTIC_ATTRS);
+        } catch (Exception e) {
+            Log.w(TAG, "Glyph Button haptic failed", e);
+        }
+    }
+
     private void sendGlyphButton(String what) {
         try {
             Intent intent = new Intent(ACTION_GLYPH_BUTTON)
-- 
