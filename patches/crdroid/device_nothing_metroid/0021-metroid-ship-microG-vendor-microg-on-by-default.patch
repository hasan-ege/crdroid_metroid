From: hasan <gungorbzk@gmail.com>
Date: Mon, 19 Oct 2026 03:52:22 +0300
Subject: [PATCH] metroid: ship microG (vendor/microg), on by default

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 device.mk | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/device.mk b/device.mk
index e05b2e9..2fd4d83 100644
--- a/device.mk
+++ b/device.mk
@@ -463,3 +463,7 @@ include $(LOCAL_PATH)/dlkm_modules.mk
 ifneq ($(CUSTOM_BRANDING_DIR),)
 $(call inherit-product-if-exists, $(CUSTOM_BRANDING_DIR)/config/branding.mk)
 endif
+
+# microG (vendor/microg, fetched and verified by tools/fetch-microg.sh): on by default, the
+# setup wizard asks.
+$(call inherit-product-if-exists, vendor/microg/microg.mk)
