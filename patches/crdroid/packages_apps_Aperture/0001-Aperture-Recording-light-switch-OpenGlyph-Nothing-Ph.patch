From 25fde02e3e92f7742e5193ca231d788e07a739ed Mon Sep 17 00:00:00 2001
From: hasan <gungorbzk@gmail.com>
Date: Mon, 19 Oct 2026 02:35:34 +0300
Subject: [PATCH] Aperture: Recording light switch (OpenGlyph, Nothing Phone
 (3))

Shown under Video only when OpenGlyph's recording light provider answers.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/src/main/AndroidManifest.xml              |  2 ++
 .../lineageos/aperture/SettingsActivity.kt    | 26 +++++++++++++++++++
 app/src/main/res/values-tr/strings.xml        |  2 ++
 app/src/main/res/values/strings.xml           |  2 ++
 app/src/main/res/xml/root_preferences.xml     |  9 +++++++
 5 files changed, 41 insertions(+)

diff --git a/app/src/main/AndroidManifest.xml b/app/src/main/AndroidManifest.xml
index 639a85e..2574476 100644
--- a/app/src/main/AndroidManifest.xml
+++ b/app/src/main/AndroidManifest.xml
@@ -31,6 +31,8 @@
         <package android:name="com.google.android.googlequicksearchbox" />
         <package android:name="org.lineageos.aperture.auto_generated_rro_product__" />
         <package android:name="org.lineageos.aperture.auto_generated_rro_vendor__" />
+        <!-- OpenGlyph recording light switch (SettingsActivity) -->
+        <provider android:authorities="org.openglyph.recordlight" />
     </queries>
 
     <application
diff --git a/app/src/main/java/org/lineageos/aperture/SettingsActivity.kt b/app/src/main/java/org/lineageos/aperture/SettingsActivity.kt
index 8229fcb..55f0569 100644
--- a/app/src/main/java/org/lineageos/aperture/SettingsActivity.kt
+++ b/app/src/main/java/org/lineageos/aperture/SettingsActivity.kt
@@ -6,6 +6,7 @@
 package org.lineageos.aperture
 
 import android.hardware.input.InputManager
+import android.net.Uri
 import android.os.Build
 import android.os.Bundle
 import android.util.Log
@@ -154,6 +155,28 @@ class SettingsActivity : AppCompatActivity(R.layout.activity_settings) {
     }
 
     class RootSettingsFragment : SettingsFragment(R.xml.root_preferences) {
+        /**
+         * The recording light lives in OpenGlyph (Nothing Phone (3)); its provider answers only
+         * this preinstalled app. Without it the switch stays hidden.
+         */
+        private fun setupRecordLight() {
+            val pref = findPreference<SwitchPreference>("record_light") ?: return
+            val resolver = requireContext().contentResolver
+            val uri = Uri.parse("content://$RECORD_LIGHT_AUTHORITY")
+            val current = runCatching {
+                resolver.call(uri, "get", null, null)?.getBoolean("enabled")
+            }.getOrNull() ?: return
+            pref.isChecked = current
+            pref.isVisible = true
+            pref.onPreferenceChangeListener = Preference.OnPreferenceChangeListener { _, value ->
+                runCatching {
+                    resolver.call(uri, "set", null, Bundle().apply {
+                        putBoolean("enabled", value as Boolean)
+                    })
+                }.isSuccess
+            }
+        }
+
         private val enableZsl by lazy { findPreference<SwitchPreference>("enable_zsl")!! }
         private val photoCaptureMode by lazy {
             findPreference<ListPreference>("photo_capture_mode")!!
@@ -210,6 +233,7 @@ class SettingsActivity : AppCompatActivity(R.layout.activity_settings) {
                     }
             }
             shutterSound?.isVisible = !CameraSoundsUtils.mustPlaySounds
+            setupRecordLight()
             videoStabilization?.isVisible = Build.DEVICE != "metroid"
 
             // Photo capture mode
@@ -385,3 +409,5 @@ class SettingsActivity : AppCompatActivity(R.layout.activity_settings) {
         private val LOG_TAG = SettingsActivity::class.simpleName!!
     }
 }
+
+private const val RECORD_LIGHT_AUTHORITY = "org.openglyph.recordlight"
diff --git a/app/src/main/res/values-tr/strings.xml b/app/src/main/res/values-tr/strings.xml
index 09970fe..b21ec6f 100644
--- a/app/src/main/res/values-tr/strings.xml
+++ b/app/src/main/res/values-tr/strings.xml
@@ -178,4 +178,6 @@
     <string name="video_mirror_mode_off">Kapalı</string>
     <string name="video_mirror_mode_on">Açık</string>
     <string name="video_mirror_mode_on_ffc_only">Yalnızca ön kamera</string>
+    <string name="record_light_title">Kayıt ışığı</string>
+    <string name="record_light_summary">Video kaydederken kameraların yanındaki kırmızı ışık yanıp sönsün</string>
 </resources>
diff --git a/app/src/main/res/values/strings.xml b/app/src/main/res/values/strings.xml
index f29f5c6..cc4cf8c 100644
--- a/app/src/main/res/values/strings.xml
+++ b/app/src/main/res/values/strings.xml
@@ -102,6 +102,8 @@
     <string name="general_header">General</string>
     <string name="photos_header">Photos</string>
     <string name="video_header">Video</string>
+    <string name="record_light_title">Recording light</string>
+    <string name="record_light_summary">Blink the red light next to the cameras while recording video</string>
     <string name="advanced_header">Advanced</string>
 
     <!-- General Preferences -->
diff --git a/app/src/main/res/xml/root_preferences.xml b/app/src/main/res/xml/root_preferences.xml
index e3f847b..2f0d405 100644
--- a/app/src/main/res/xml/root_preferences.xml
+++ b/app/src/main/res/xml/root_preferences.xml
@@ -115,6 +115,15 @@
             app:title="@string/video_mirror_mode_title"
             app:useSimpleSummaryProvider="true" />
 
+        <!-- Shown only where OpenGlyph provides a recording light (Nothing Phone (3)) -->
+        <SwitchPreference
+            app:iconSpaceReserved="false"
+            app:isPreferenceVisible="false"
+            app:key="record_light"
+            app:persistent="false"
+            app:summary="@string/record_light_summary"
+            app:title="@string/record_light_title" />
+
     </PreferenceCategory>
 
     <PreferenceCategory
