         remainingSecondsChanged(sec)
     }
 
@@ -123,6 +125,7 @@ class CountDownView(context: Context, attrs: AttributeSet?) : FrameLayout(
         if (remainingSeconds > 0) {
             remainingSeconds = 0
             handler.removeMessages(SET_TIMER_TEXT)
