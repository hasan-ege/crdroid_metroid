 .../aperture/utils/GlyphCountdown.kt          | 27 +++++++++++++++++++
 2 files changed, 30 insertions(+)
 create mode 100644 app/src/main/java/org/lineageos/aperture/utils/GlyphCountdown.kt

diff --git a/app/src/main/java/org/lineageos/aperture/ui/views/CountDownView.kt b/app/src/main/java/org/lineageos/aperture/ui/views/CountDownView.kt
index e94e0f8..2105338 100644
--- a/app/src/main/java/org/lineageos/aperture/ui/views/CountDownView.kt
+++ b/app/src/main/java/org/lineageos/aperture/ui/views/CountDownView.kt
@@ -21,6 +21,7 @@ import androidx.core.view.isVisible
 import org.lineageos.aperture.R
 import org.lineageos.aperture.ext.smoothRotate
 import org.lineageos.aperture.models.Rotation
