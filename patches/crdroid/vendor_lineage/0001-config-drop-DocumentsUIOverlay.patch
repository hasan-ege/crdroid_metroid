From 472e4b580c3f6c0c040bd8c16b4718a3e48b890b Mon Sep 17 00:00:00 2001
From: hasan <hasan@localhost>
Date: Sun, 18 Oct 2026 07:13:04 +0300
Subject: [PATCH] config: drop DocumentsUIOverlay

Ship the stock AOSP look of the Files app (DocumentsUI) without Lineage's
Material 3 theme overlay.
---
 config/common.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/config/common.mk b/config/common.mk
index ed7984e..5250bb3 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -280,8 +280,8 @@ PRODUCT_PACKAGE_OVERLAYS += \
     vendor/lineage/overlay/common \
     vendor/lineage/overlay/no-rro
 
+# DocumentsUIOverlay (Material 3 theme for Files) left out on metroid: plain AOSP Files.
 PRODUCT_PACKAGES += \
-    DocumentsUIOverlay \
     NetworkStackOverlay \
     PermissionControllerOverlay
 
