diff --git a/res/drawable/ic_essential_key_expressive.xml b/res/drawable/ic_essential_key_expressive.xml
new file mode 100644
index 00000000..5c51194e
--- /dev/null
+++ b/res/drawable/ic_essential_key_expressive.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Essential Key homepage icon, tinted like the other expressive icons. -->
+<com.android.settings.widget.TintDrawable
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:drawable="@drawable/ic_essential_key_filled"
+    android:tint="@color/homepage_essential_key_foreground" />
diff --git a/res/drawable/ic_essential_key_filled.xml b/res/drawable/ic_essential_key_filled.xml
new file mode 100644
index 00000000..33c4a6cb
--- /dev/null
+++ b/res/drawable/ic_essential_key_filled.xml
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Essential Key: a phone with its side key lit. -->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="24dp"
+    android:height="24dp"
+    android:viewportWidth="24"
+    android:viewportHeight="24">
+    <path
+        android:fillColor="#FF000000"
+        android:pathData="M8,2h7a3,3 0,0 1,3 3v14a3,3 0,0 1,-3 3h-7a3,3 0,0 1,-3 -3v-14a3,3 0,0 1,3 -3zM8,4a1,1 0,0 0,-1 1v14a1,1 0,0 0,1 1h7a1,1 0,0 0,1 -1v-14a1,1 0,0 0,-1 -1z" />
+    <path
+        android:fillColor="#FF000000"
+        android:pathData="M19,7.5h1a1,1 0,0 1,1 1v4a1,1 0,0 1,-1 1h-1z" />
+</vector>
diff --git a/res/drawable/ic_homepage_essential_key.xml b/res/drawable/ic_homepage_essential_key.xml
new file mode 100644
index 00000000..37a1729c
--- /dev/null
+++ b/res/drawable/ic_homepage_essential_key.xml
@@ -0,0 +1,16 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Essential Key homepage icon on a coloured background chip, like ic_homepage_*. -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item>
+        <com.android.settingslib.widget.AdaptiveIconShapeDrawable
+            android:width="@dimen/dashboard_tile_image_size"
+            android:height="@dimen/dashboard_tile_image_size"
+            android:color="@color/homepage_essential_key_background" />
+    </item>
+    <item
+        android:width="@dimen/dashboard_tile_foreground_image_size"
+        android:height="@dimen/dashboard_tile_foreground_image_size"
+        android:start="@dimen/dashboard_tile_foreground_image_inset"
+        android:top="@dimen/dashboard_tile_foreground_image_inset"
+        android:drawable="@drawable/ic_essential_key_expressive" />
+</layer-list>
